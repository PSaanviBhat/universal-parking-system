// This is the Prisma schema file for the Universal Parking System.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────────────
model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String             @unique
  passwordHash      String
  isSuspended       Boolean            @default(false)
  isBlacklisted     Boolean            @default(false)
  tcAcceptedAt      DateTime?          // T&C + autopay authorization timestamp
  indoorNavEnabled  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  vehicles          Vehicle[]
  wallet            Wallet?
  paymentMethods    PaymentMethod[]
  parkingSessions   ParkingSession[]
  suspensionRecords SuspensionRecord[]
  paymentOrders     PaymentOrder[]
}

// ─── VEHICLES ─────────────────────────────────────────────────────────────────
model Vehicle {
  id                String             @id @default(uuid())
  userId            String
  licensePlate      String             @unique
  nickname          String?
  createdAt         DateTime           @default(now())

  user              User               @relation(fields: [userId], references: [id])
  parkingSessions   ParkingSession[]
  suspensionRecords SuspensionRecord[]
}

// ─── WALLETS ──────────────────────────────────────────────────────────────────
model Wallet {
  id                    String               @id @default(uuid())
  userId                String               @unique
  balance               Decimal              @default(0) @db.Decimal(10, 2)
  // Debt tracking
  debtCreatedAt         DateTime?            // When balance first went negative
  debtDeadline          DateTime?            // debtCreatedAt + 48 hours
  autopayAuthorized     Boolean              @default(false)
  linkedPaymentMethodId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user                  User                 @relation(fields: [userId], references: [id])
  linkedPaymentMethod   PaymentMethod?       @relation(fields: [linkedPaymentMethodId], references: [id])
  transactions          WalletTransaction[]
}

// ─── WALLET TRANSACTIONS ──────────────────────────────────────────────────────
model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2) // Always positive; direction inferred from type
  description String
  sessionId   String?
  createdAt   DateTime        @default(now())

  wallet      Wallet          @relation(fields: [walletId], references: [id])
  session     ParkingSession? @relation(fields: [sessionId], references: [id])
}

enum TransactionType {
  TOP_UP
  PARKING_CHARGE
  DEBT_REPAYMENT
  AUTOPAY
  FINE
  REFUND
}

// ─── PAYMENT ORDERS (wallet top-ups) ──────────────────────────────────────────
// Every top-up must reference an order created by POST /api/wallet/create-order.
// The credited amount comes from the order, and the CREATED -> PAID transition
// happens exactly once, which blocks replayed or tampered top-up requests.
model PaymentOrder {
  id                String             @id @default(uuid())
  userId            String
  razorpayOrderId   String             @unique
  amountPaise       Int
  status            PaymentOrderStatus @default(CREATED)
  razorpayPaymentId String?            @unique
  isSimulated       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  paidAt            DateTime?

  user              User               @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

// ─── PAYMENT METHODS ──────────────────────────────────────────────────────────
model PaymentMethod {
  id              String    @id @default(uuid())
  userId          String
  type            String    // UPI | CARD | NETBANKING
  razorpayToken   String    // Razorpay saved payment token (encrypted)
  isPrimary       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])
  wallets         Wallet[]
}

// ─── PARKING FACILITIES ───────────────────────────────────────────────────────
model ParkingFacility {
  id              String           @id @default(uuid())
  name            String
  type            FacilityType
  address         String
  feeRatePerHour  Decimal          @default(30.00) @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  levels          ParkingLevel[]
  gates           ParkingGate[]
  parkingSessions ParkingSession[]
}

enum FacilityType {
  MALL
  OFFICE
  HOSPITAL
  AIRPORT
  HOTEL
  UNIVERSITY
  PUBLIC
  EVENT_VENUE
  COMMERCIAL
}

// ─── PARKING LEVELS ───────────────────────────────────────────────────────────
model ParkingLevel {
  id          String          @id @default(uuid())
  facilityId  String
  levelCode   String          // e.g. "B1", "G", "L1", "L2"
  displayName String          // e.g. "Basement 1", "Ground Floor"
  floorMapUrl String?         // Cloudinary URL to SVG/PNG floor plan
  totalSlots  Int
  createdAt   DateTime        @default(now())

  facility    ParkingFacility @relation(fields: [facilityId], references: [id])
  slots       ParkingSlot[]

  @@unique([facilityId, levelCode])
}

// ─── PARKING SLOTS ────────────────────────────────────────────────────────────
model ParkingSlot {
  id               String         @id @default(uuid())
  levelId          String
  facilityId       String
  slotNumber       String         // e.g. "A-01", "B-14"
  status           SlotStatus     @default(AVAILABLE)
  coordinateX      Float?         // For floor map marker (0–100 %)
  coordinateY      Float?
  currentSessionId String?        @unique
  isActive         Boolean        @default(true) // Operator can deactivate a slot
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  level            ParkingLevel   @relation(fields: [levelId], references: [id])
  currentSession   ParkingSession? @relation("SlotCurrentSession", fields: [currentSessionId], references: [id])
  sessions         ParkingSession[] @relation("SlotSessions")

  @@unique([levelId, slotNumber])
}

enum SlotStatus {
  AVAILABLE
  RESERVED_OCCUPIED // Unified state: billing starts at assignment (reserved = occupied)
}

// ─── PARKING GATES ────────────────────────────────────────────────────────────
model ParkingGate {
  id           String          @id @default(uuid())
  facilityId   String
  gateType     GateType
  gateName     String          // e.g. "North Entry Gate 1"
  qrCodeData   String          @unique // Unique string encoded in the QR
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  facility     ParkingFacility @relation(fields: [facilityId], references: [id])
  entrySessions ParkingSession[] @relation("EntryGate")
  exitSessions  ParkingSession[] @relation("ExitGate")
}

enum GateType {
  ENTRY
  EXIT
}

// ─── PARKING SESSIONS ─────────────────────────────────────────────────────────
model ParkingSession {
  id               String          @id @default(uuid())
  vehicleId        String
  userId           String
  facilityId       String
  slotId           String
  entryGateId      String
  exitGateId       String?
  entryTime        DateTime
  exitTime         DateTime?
  durationMinutes  Int?
  feeRateSnapshot  Decimal         @db.Decimal(10, 2) // Rate captured at session start
  totalFee         Decimal?        @db.Decimal(10, 2)
  status           SessionStatus   @default(ACTIVE)
  paymentStatus    PaymentStatus   @default(PENDING)
  resolutionNote   String?         // Operator note for force-close / dispute handling
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  facility         ParkingFacility @relation(fields: [facilityId], references: [id])
  slot             ParkingSlot     @relation("SlotSessions", fields: [slotId], references: [id])
  currentSlot      ParkingSlot?    @relation("SlotCurrentSession")
  entryGate        ParkingGate     @relation("EntryGate", fields: [entryGateId], references: [id])
  exitGate         ParkingGate?    @relation("ExitGate", fields: [exitGateId], references: [id])
  walletTransactions WalletTransaction[]
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  DISPUTED
}

enum PaymentStatus {
  PENDING         // Session active — no charge yet
  PAID            // Fee fully collected from wallet
  DEBT            // Wallet went negative; 48h repayment window open
  AUTOPAY_PENDING // 48h passed; autopay being triggered
  FINED           // Autopay failed; account suspended + fined
}

// ─── SUSPENSION RECORDS ───────────────────────────────────────────────────────
model SuspensionRecord {
  id          String    @id @default(uuid())
  userId      String
  vehicleId   String
  reason      String    // e.g. "AUTOPAY_FAILURE"
  fineAmount  Decimal   @default(0) @db.Decimal(10, 2)
  isPaid      Boolean   @default(false)
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
}
