# Database
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/parking?sslmode=require

# JWT Secrets (use long random strings — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
OPERATOR_JWT_SECRET=
ADMIN_JWT_SECRET=

# Server
PORT=4000
NODE_ENV=production

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=
# Local dev only: issue simulated orders when Razorpay keys are not set.
# Ignored when NODE_ENV=production.
ALLOW_SIMULATED_PAYMENTS=true

# Wallet rules
MINIMUM_WALLET_TOPUP=35
MAXIMUM_WALLET_TOPUP=10000
DEBT_REPAYMENT_WINDOW_HOURS=48
# One-time fine when autopay fails after the debt window (account is suspended)
DEBT_FINE_AMOUNT=500

# Operations
STALE_SESSION_HOURS=24
FACILITY_TIMEZONE=Asia/Kolkata

# CORS + Socket.io (comma-separate several origins, e.g. production + preview)
DASHBOARD_URL=https://your-dashboard.vercel.app

# Seed (npm run db:seed) — staff accounts are created with bcrypt-hashed passwords.
# Leave a password empty to auto-generate one (printed once) for a new account.
# SEED_RESET=true wipes all data first (refused when NODE_ENV=production).
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_USERNAME=operator1
SEED_OPERATOR_PASSWORD=
