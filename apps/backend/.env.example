# Database
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/parking?sslmode=require

# JWT Secrets (use long random strings — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
OPERATOR_JWT_SECRET=
ADMIN_JWT_SECRET=

# Server
PORT=4000
NODE_ENV=production

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=

# CORS
DASHBOARD_URL=https://your-dashboard.vercel.app
