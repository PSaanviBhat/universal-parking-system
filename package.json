{
  "name": "parking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Parking System — Monorepo Root",
  "workspaces": [
    "apps/backend",
    "apps/dashboard"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=apps/backend",
    "dashboard": "npm run dev --workspace=apps/dashboard",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "build": "npm run build --workspaces",
    "start:backend": "npm run start --workspace=apps/backend"
  }
}
